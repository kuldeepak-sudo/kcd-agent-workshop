{
  "openapi": "3.0.3",
  "info": {
    "title": "acme-mcp-proxy",
    "version": "1.0.0"
  },
  "paths": {
    "/mcp": {
      "post": {
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      },
      "get": {
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  },
  "x-tyk-api-gateway": {
    "info": {
      "name": "acme-mcp-proxy",
      "state": {
        "active": true
      },
      "id": "87ba7c68b57f45ed85269b5a3ad897d4"
    },
    "upstream": {
      "url": "http://acme-mcp-server.tyk-oss.svc.cluster.local:7878"
    },
    "server": {
      "listenPath": {
        "value": "/acme-mcp/",
        "strip": true
      },
      "authentication": {
        "enabled": true,
        "baseIdentityProvider": "jwt_claim",
        "securitySchemes": {
          "keycloakJwt": {
            "enabled": true,
            "header": {
              "enabled": true,
              "name": "Authorization"
            },
            "jwksURIs": [
              {
                "url": "http://acme-keycloak.tyk-oss.svc.cluster.local:8280/realms/acme/protocol/openid-connect/certs",
                "cacheTimeout": "0s"
              }
            ],
            "signingMethod": "rsa",
            "identityBaseField": "sub",
            "defaultPolicies": [
              "acme-demo-default"
            ]
          }
        }
      }
    },
    "middleware": {
      "global": {
        "trafficLogs": {
          "enabled": true
        },
        "pluginConfig": {
          "driver": "grpc"
        },
        "postPlugins": [
          {
            "enabled": true,
            "functionName": "TokenExchangePostHook"
          }
        ]
      },
      "operations": {
        "tools/callPOST": {
          "rateLimit": {
            "rate": 30,
            "per": "60s",
            "enabled": true
          }
        }
      },
      "mcpTools": {
        "lookup_customer": {
          "allow": {
            "enabled": true
          }
        },
        "recent_orders": {
          "allow": {
            "enabled": true
          }
        },
        "update_customer": {
          "allow": {
            "enabled": true
          }
        },
        "issue_refund": {
          "allow": {
            "enabled": true
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "keycloakJwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "keycloakJwt": []
    }
  ]
}
